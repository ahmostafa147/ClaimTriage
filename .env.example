# Application mode: MOCK (offline synthetic data) or PROD (real LandingAI ADE)
APP_MODE=MOCK

# LandingAI ADE API key for production document extraction
LANDINGAI_API_KEY=

# Enable Pathway streaming for real-time processing
USE_PATHWAY_STREAMING=false

# Pathway configuration (optional)
PATHWAY_LICENSE_KEY=
PATHWAY_MONITORING_SERVER=
